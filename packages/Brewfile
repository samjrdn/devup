# Command line packages installed on macOS by ./setup.sh.
#
# Always installed, including on remote servers, so keep this file headless. GUI applications belong in Brewfile.full.
#
# Add a line, re-run ./setup.sh, and only the new package is installed.
# Full syntax: https://github.com/Homebrew/homebrew-bundle

## Required by the config in this repo

brew "git"          # git/.gitconfig.sym
brew "vim"          # core.editor
# gnupg is deliberately NOT listed here. commit.gpgsign needs a gpg, but
# Homebrew's gnupg cannot link over a GPG Suite install, which owns
# /usr/local/bin/gpg — listing it makes `brew bundle` fail on every run for
# anyone who has GPG Suite. setup.sh checks for a working gpg instead and
# tells you what to install. Pick one:
#   brew install gnupg          (if you have no gpg at all)
#   https://gpgtools.org        (GPG Suite, with a GUI keychain)
brew "shellcheck"   # shell/.shellcheckrc.sym

## Version manager for ruby, python and node — see shell/common.sh

brew "mise"

## General command line

brew "curl"
brew "wget"
brew "jq"
brew "ripgrep"
brew "fd"
brew "fzf"
brew "tree"
brew "htop"
brew "coreutils"

## Secrets — see shell/env.sh

cask "1password-cli"

## Claude Code

cask "claude-code"
