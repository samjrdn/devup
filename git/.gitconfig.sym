[core]
  editor = vim
  autocrlf = input
  commitGraph = true
  excludesfile = ~/.gitignore_global

[init]
  defaultBranch = main

[alias]
  default-branch = !git symbolic-ref refs/remotes/origin/HEAD | cut -f4 -d/
  start          = !git checkout $(git default-branch) && git pull && git clean -fd
  a = add
  b = branch
  c = commit
  co = checkout
  d = diff
  l = log --name-only --oneline
  r = branch --sort=committerdate
  s = status
  shove = push --force-with-lease

[branch]
  sort = -committerdate

[fetch]
  prune = true

[pull]
  rebase = false

[rebase]
  autoStash = true

[diff]
  algorithm = patience

[gc]
  writeCommitGraph = true

[protocol]
  version = 2

# Signing uses an SSH key rather than GPG: same on macOS and Linux, no gpg
# install needed, and it can be backed by 1Password's SSH agent.
#
# Only the format is set here. Whether to actually sign, which key, and the
# 1Password signer path are all written to ~/.gitconfig.local by
# `./setup.sh --full`, so a remote server is not left with signing switched
# on and no key to sign with.
[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers

# Identity and signing key, which differ per machine and are never committed.
# setup.sh creates this file, carrying over any identity the machine already
# had. Included last so it overrides anything above.
[include]
  path = ~/.gitconfig.local

# Extra config for repositories under a directory named "shopify".
[includeIf "gitdir/i:**/shopify/**"]
  path = ~/.gitconfig.work
